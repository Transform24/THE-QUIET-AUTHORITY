{
  "name": "remotion",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "studio": "remotion studio src/index.js",
    "render:short": "remotion render src/index.js QuietAuthorityShort out/quiet-authority-short.mp4",
    "render:wide": "remotion render src/index.js QuietAuthorityWide out/quiet-authority-wide.mp4",
    "render:square": "remotion render src/index.js QuietAuthoritySquare out/quiet-authority-square.mp4",
    "render:all": "npm run render:short && npm run render:wide && npm run render:square",
    "stage-audio": "node scripts/stage-audio.mjs music1.mp3",
    "validate:psalm91": "node scripts/validate-psalm91.mjs",
    "test:validator": "node scripts/test-validator.mjs",
    "prestudio": "npm run stage-audio",
    "prerender:psalm91": "npm run validate:psalm91 && npm run stage-audio",
    "render:psalm91": "remotion render src/index.js Psalm91Full out/psalm91-full.mp4",
    "prerender:psalm91:clips": "npm run validate:psalm91 && npm run stage-audio",
    "render:psalm91:clips": "node scripts/render-clips.mjs Psalm91Verse src/data/psalm91.json out/clips psalm91-verse",
    "validate:tqa": "node scripts/validate-tqa-pattern.mjs",
    "prerender:tqa": "npm run validate:tqa && npm run stage-audio",
    "render:tqa": "remotion render src/index.js TQAPattern out/tqa-pattern-8min.mp4",
    "validate:tqa-prayer": "node scripts/validate-tqa-prayer-posture.mjs",
    "prerender:tqa-prayer": "npm run validate:tqa-prayer && npm run stage-audio",
    "render:tqa-prayer": "remotion render src/index.js TQA-Stillness-Journey-FINAL-v10 out/TQA_Stillness_Journey_FINAL_v10.mp4 --overwrite"
  },
  "remotion": {
    "entryPoint": "src/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/cli": "4.0.438",
    "@remotion/player": "4.0.438",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.438"
  }
}
